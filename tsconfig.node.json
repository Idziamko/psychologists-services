{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "composite": true,
    "emitDeclarationOnly": false,
    "outDir": "./node_modules/.tmp"
  },
  "include": [
    "vite.config.ts"
  ]
}
